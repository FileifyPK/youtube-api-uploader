# Sacred Knowledge YouTube uploader — example environment file.
# PLACEHOLDERS ONLY. Never put real secrets in this file or any file.
# Real values live in each agent's Secure Vault and are injected as
# environment variables at runtime. Copy to .env and fill in locally;
# .env is git-ignored and must never be committed.

# --- Agent identity (one of: muse, meem, agent3) ---
AGENT_ID=muse

# --- Google OAuth (Desktop client) ---
# Client ID / secret from the Google Cloud project "Sacred Knowledge Uploads".
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
# Per-agent refresh token, obtained via the user's own browser consent
# and stored straight into the Secure Vault. Never paste into chat.
YOUTUBE_REFRESH_TOKEN=YOUR_REFRESH_TOKEN

# --- Neon PostgreSQL (restricted per-agent credentials) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- Behaviour ---
# DRY_RUN=true means: no videos.insert, no captions/thumbnail/playlist
# calls, no state transitions past approved_for_upload. Default: true.
DRY_RUN=true
# Kill switch is read from the database (system_settings.global_upload_enabled,
# default FALSE). This env var is only a local override for testing and
# can only ever turn uploads OFF, never ON.
UPLOADS_FORCE_OFF=true
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
